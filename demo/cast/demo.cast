[0.012, "o", "HTTP/1.1 401 Unauthorized\r\r\n"]
[1.507, "o", "\u001b[2m# Add it. albauth probes the domain and works out how its login behaves.\u001b[0m\r\n"]
[1.007, "o", "\u001b[2m# The Authorization header is Grafana's own credential: the second layer, behind the proxy.\u001b[0m\r\n"]
