[0.019, "o", "\u001b[H\u001b[J"]
[0.000, "o", "\u001b[2m# Grafana sits behind oauth2-proxy and Traefik forwardAuth. A plain request gets turned away:\u001b[0m\r\n"]
[1.007, "o", "\u001b[1;32m$\u001b[0m c"]
