[30.262, "o", "\u001b[1;39m{\r\n  \u001b[0m\u001b[1;34m\"status\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;39m200\u001b[0m\u001b[1;39m,\r\n  \u001b[0m\u001b[1;34m\"authenticated\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;39mtrue\u001b[0m\u001b[1;39m,\r\n  \u001b[0m\u001b[1;34m\"body\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[1;39m{\r\n    \u001b[0m\u001b[1;34m\"login\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"admin\"\u001b[0m\u001b[1;39m,\r\n    \u001b[0m\u001b[1;34m\"email\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"admin@localhost\"\u001b[0m\u001b[1;39m\r\n  \u001b[1;39m}\u001b[0m\u001b[1;39m\r\n\u001b[1;39m}\u001b[0m\r\n"]
